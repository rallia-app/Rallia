# =====================================
# Supabase Configuration
# =====================================
# Get these from: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# =====================================
# Resend (Email)
# =====================================
# Get from: https://resend.com
RESEND_API_KEY=your-resend-api-key

# =====================================
# Base URLs
# =====================================
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =====================================
# Google Maps / Places API
# =====================================
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# =====================================
# Dev-mode API mocks
# =====================================
# When mocks are active, Google Places / Geocoding / Time Zone calls
# return canned data instead of hitting Google (saves free-tier quota).
# Default: on in dev (NODE_ENV !== 'production'), off in prod.
# Set to "false" to hit the real API in dev when you need to verify behavior.
# NEXT_PUBLIC_USE_API_MOCKS=false

# =====================================
# Stripe
# =====================================
STRIPE_SECRET_KEY=your-stripe-secret-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# =====================================
# PostHog Analytics
# =====================================
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Server-only: PostHog Personal API key (read scope) used by /api/admin/analytics/utm
# to run HogQL queries. WARNING: this grants read access to ALL PostHog data —
# only the admin-gated route uses it. Generate at https://us.posthog.com/me/settings.
POSTHOG_PERSONAL_KEY=your-personal-api-key
# Numeric project id from your PostHog URL (e.g. https://us.posthog.com/project/12345 → 12345).
POSTHOG_PROJECT_ID=your-project-id

# =====================================
# Sentry Error Tracking
# =====================================
# Get the DSN from: Sentry Dashboard → Project Settings → Client Keys (DSN)
# Get the auth token from: Sentry → Settings → Auth Tokens
NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn-here
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# =====================================
# iOS Attribution Handoff
# =====================================
# Server-only HMAC key used by /api/attribution/sign + /api/attribution/verify
# to sign the clipboard handoff token that bridges web visits to iOS installs.
# MUST be a high-entropy random string — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this key invalidates any in-flight clipboard tokens (15-min window).
ATTRIBUTION_SIGNING_KEY=your-32-byte-random-hex

# =====================================
# Meta (Facebook) Domain Verification
# =====================================
# One token per domain we serve. Get from Meta Business Manager → Brand
# Safety → Domains → Verify your domain (Meta-tag method). Required to
# associate each domain with our Meta app for iOS app linkage and AEM.
# The root layout emits all set tokens as separate meta tags; Meta's
# crawler at each host matches its own token and ignores the others.
NEXT_PUBLIC_FB_DOMAIN_VERIFICATION=     # token for rallia.app
NEXT_PUBLIC_FB_DOMAIN_VERIFICATION_CA=  # token for rallia.ca
