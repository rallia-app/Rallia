# Server-only. No NEXT_PUBLIC_ prefix: this is what keeps the database host out
# of the browser bundle.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Do NOT set NEXT_PUBLIC_GOOGLE_PLACES_API_KEY: that would make the
# browser call googleapis.com directly and bypass the /api/places proxy.
GOOGLE_PLACES_API_KEY=

# Proxied through /ingest, so no third-party host appears in the network tab.
NEXT_PUBLIC_POSTHOG_KEY=
